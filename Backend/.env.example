# Copy to .env and fill in. Never commit the real .env.

# Model API keys
GOOGLE_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# History, sharing and export need MongoDB. Leave empty to run without them
# (battles still work, they just are not saved).
# Local:  mongodb://127.0.0.1:27017/battle-arena
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/battle-arena
MONGODB_URI=

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Optional: override list prices (USD per 1 million tokens) used for the cost estimate.
# Defaults are approximate list prices checked on 2026-10-22; check your providers' pricing pages.
# PRICE_GROQ_IN=0.15
# PRICE_GROQ_OUT=0.60
# PRICE_COHERE_IN=2.5
# PRICE_COHERE_OUT=10
# PRICE_GEMINI_IN=0.75
# PRICE_GEMINI_OUT=3.75
